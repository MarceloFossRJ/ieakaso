      "updated": 1794434138656,
      "link": null,
      "locked": false,
      "text": "Helps a candidate on the preparation to find the right\njob, discover his strengths, weaknesses, improve the cv, \nlinkedIn profile, prepare for interviews.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Helps a candidate on the preparation to find the right\njob, discover his strengths, weaknesses, improve the cv, \nlinkedIn profile, prepare for interviews.",
      "autoResize": true,
