    },
    {
      "id": "HXvpI26ST61WUOOXEH994",
      "type": "text",
      "x": 760.8472433750444,
      "y": 210.13762363429333,
      "width": 466.3356018066406,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
