      "versionNonce": 1451650353,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794864527999,
      "link": null,
      "locked": false,
      "text": "Act as seasoned recruiter so the input can be challenged\nat the level of one specific job application. Give chances\nover a job ad. Sees only the CV, the job ad & Cover letter. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Act as seasoned recruiter so the input can be challenged\nat the level of one specific job application. Give chances\nover a job ad. Sees only the CV, the job ad & Cover letter. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
