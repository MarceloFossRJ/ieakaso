    {
      "id": "q4i9DoV8gz4FkQ1okTBGz",
      "type": "text",
      "x": 1070,
      "y": -450,
      "width": 624.8000000000001,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0025",
      "roundness": null,
      "seed": 1456492750,
      "version": 1,
      "versionNonce": 1809368695,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794500000000,
      "link": null,
      "locked": false,
      "text": "- Career Coach: no new agent. Its work (gaps, strategy, evidence) is\n  job-analyzer's, plus the new Evidence bank.\n- Screening (strong/weak points, chances): stays in job-analyzer, which\n  already scores the CV only, as a real recruiter would.\n- One decision instead of three: the Verdict, then 'apply anyway?'.\n- Knowledge base reads: 1 per Application instead of up to 11\n  (job-analyzer + Applicant and Recruiter in each of up to 5 Rounds).\n- The claim check stays: the Recruiter checks claims against the bank.\n- Agents unchanged: applicant, recruiter, company-researcher,\n  job-application-assistant. Only their INPUTS change.",
      "originalText": "- Career Coach: no new agent. Its work (gaps, strategy, evidence) is\n  job-analyzer's, plus the new Evidence bank.\n- Screening (strong/weak points, chances): stays in job-analyzer, which\n  already scores the CV only, as a real recruiter would.\n- One decision instead of three: the Verdict, then 'apply anyway?'.\n- Knowledge base reads: 1 per Application instead of up to 11\n  (job-analyzer + Applicant and Recruiter in each of up to 5 Rounds).\n- The claim check stays: the Recruiter checks claims against the bank.\n- Agents unchanged: applicant, recruiter, company-researcher,\n  job-application-assistant. Only their INPUTS change.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
