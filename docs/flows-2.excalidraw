      "boundElements": [],
      "updated": 1794500000000,
      "link": null,
      "locked": false,
      "text": "Built by code in every cover-letter Run: the Job analysis's strategy sections\nand the Company research's usable, fetched facts, old ones tagged. The agents\nread it instead of both files: never red flags or employee reviews.",
      "originalText": "Built by code in every cover-letter Run: the Job analysis's strategy sections\nand the Company research's usable, fetched facts, old ones tagged. The agents\nread it instead of both files: never red flags or employee reviews.",
